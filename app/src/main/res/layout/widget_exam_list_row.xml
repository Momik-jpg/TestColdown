<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widgetRowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:minHeight="74dp"
        android:background="@drawable/widget_row_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/widget_date_background"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:importantForAccessibility="noHideDescendants">
        <TextView
        android:id="@+id/widgetRowDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_day"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="@color/widget_chip_text" />
        <TextView
        android:id="@+id/widgetRowMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_month"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="@color/widget_chip_text" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
        android:id="@+id/widgetRowKind"
        android:text="@string/widget_preview_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:singleLine="true"
        android:ellipsize="end" />
        <TextView
        android:id="@+id/widgetRowTitle"
        android:text="@string/widget_preview_exam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_surface"
        android:singleLine="true"
        android:ellipsize="end" />
        <TextView
        android:id="@+id/widgetRowDetails"
        android:text="@string/widget_preview_row_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:singleLine="true"
        android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
