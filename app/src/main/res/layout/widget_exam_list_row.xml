<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widgetRowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:minHeight="66dp"
        android:background="@drawable/widget_row_background"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
    <TextView
        android:id="@+id/widgetRowKind"
        android:text="@string/widget_preview_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent"
        android:singleLine="true"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widgetRowTitle"
        android:text="@string/widget_preview_exam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_surface"
        android:singleLine="true"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widgetRowDetails"
        android:text="@string/widget_preview_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
