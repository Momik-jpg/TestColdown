<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nextWidgetHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nächste Prüfung"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextWidgetOpenTimetable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_chip_background"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Zum Plan"
            android:textColor="@color/widget_chip_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextWidgetRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_chip_background"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/nextExamTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Maturaprüfung Deutsch"
        android:textColor="@color/widget_on_surface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nextExamTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Do, 27.02.2026 · 08:00"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nextExamCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_countdown_badge_background"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="in 3 Tagen 4 Std"
        android:textColor="@color/widget_badge_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
