<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_focus_background">
    <LinearLayout
        android:id="@+id/nextFocusPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
            <TextView
        android:id="@+id/nextWidgetHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_next_title"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_focus_muted" />
            <ImageButton
        android:id="@+id/nextWidgetConfigure"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:background="@android:color/transparent"
        android:src="@drawable/widget_settings_focus"
        android:contentDescription="@string/widget_configure" />
            <ImageButton
        android:id="@+id/nextWidgetRefresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:background="@android:color/transparent"
        android:src="@drawable/widget_refresh_focus"
        android:contentDescription="@string/widget_refresh" />
        </LinearLayout>
        <TextView
        android:id="@+id/nextExamTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_next"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_focus_text"
        android:layout_marginTop="12dp" />
        <FrameLayout
        android:id="@+id/nextCountdownBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
            <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:src="@drawable/widget_focus_ring"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
                <TextView
        android:id="@+id/nextExamCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_number"
        android:textSize="96sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_focus_text" />
                <TextView
        android:id="@+id/nextCountdownUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_unit"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_focus_muted" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
        android:id="@+id/nextDetailsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:background="@drawable/widget_focus_details"
        android:padding="12dp">
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:orientation="vertical">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_when"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="@color/widget_focus_muted" />
                <TextView
        android:id="@+id/nextExamTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_next_time"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/widget_focus_text" />
            </LinearLayout>
            <LinearLayout
        android:id="@+id/nextLocationSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_where"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="@color/widget_focus_muted" />
                <TextView
        android:id="@+id/nextExamLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_location"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/widget_focus_text" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
        android:id="@+id/nextUpcomingArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">
            <TextView
        android:id="@+id/nextUpcomingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_upcoming"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/widget_focus_muted"
        android:singleLine="true"
        android:ellipsize="end" />
            <LinearLayout
        android:id="@+id/nextUpcomingRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />
            <TextView
        android:id="@+id/nextUpcomingEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_no_more_entries"
        android:textSize="12sp"
        android:textColor="@color/widget_focus_muted" />
        </LinearLayout>
        <TextView
        android:id="@+id/nextWidgetOpenTimetable"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/widget_open_timetable"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_focus_muted"
        android:singleLine="true"
        android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
