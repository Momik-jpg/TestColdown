<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/listWidgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_background"
        android:orientation="vertical"
        android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
        android:id="@+id/listWidgetHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_exams_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_on_surface" />
        <ImageButton
        android:id="@+id/listWidgetConfigure"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:background="@android:color/transparent"
        android:src="@drawable/widget_settings"
        android:contentDescription="@string/widget_configure" />
        <ImageButton
        android:id="@+id/listWidgetRefresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:background="@android:color/transparent"
        android:src="@drawable/widget_refresh"
        android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView
        android:id="@+id/listWidgetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_window"
        android:textSize="12sp"
        android:textColor="@color/widget_muted"
        android:singleLine="true"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/listEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:textColor="@color/widget_muted"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <include layout="@layout/widget_exam_list_row" />
        <include layout="@layout/widget_exam_list_row" />
    </LinearLayout>
    <TextView
        android:id="@+id/listWidgetOpenTimetable"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/widget_open_timetable"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
